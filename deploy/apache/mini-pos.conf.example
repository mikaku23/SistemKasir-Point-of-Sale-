# Example Apache virtual-host configuration for a Linux deployment.
# Adjust paths to the actual deployment directory before enabling.
<VirtualHost *:80>
    ServerName mini-pos.local

    DocumentRoot /var/www/mini-pos/web

    <Directory /var/www/mini-pos/web>
        Options -Indexes
        AllowOverride None
        Require all granted
    </Directory>

    ScriptAlias /cgi-bin/ /var/www/mini-pos/cgi-bin/

    <Directory /var/www/mini-pos/cgi-bin>
        Options +ExecCGI -Indexes
        AddHandler cgi-script .cgi
        Require all granted
    </Directory>

    # Do not expose application source, config, database or session folders.
    <Directory /var/www/mini-pos>
        Require all denied
    </Directory>
    <Directory /var/www/mini-pos/web>
        Require all granted
    </Directory>
    <Directory /var/www/mini-pos/cgi-bin>
        Require all granted
        Options +ExecCGI -Indexes
        AddHandler cgi-script .cgi
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/mini-pos-error.log
    CustomLog ${APACHE_LOG_DIR}/mini-pos-access.log combined
</VirtualHost>
