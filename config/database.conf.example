# MINI POS local database connection.
# Copy this file to config/database.conf and fill in the local credentials.
# Ubuntu MariaDB: commonly host=localhost.
# Windows + Laragon + Git Bash: commonly host=127.0.0.1.
# Never commit config/database.conf; it is excluded by .gitignore.

[client]
host=localhost
port=3306
user=mini_pos_app
password=CHANGE_THIS_PASSWORD
database=mini_pos
default-character-set=utf8mb4
